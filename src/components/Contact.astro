---
import { profile, contactLinks } from '../data/profile';
import ContactLink from './ContactLink.astro';
---

<section class="bento-tile bento-contact" id="contact" aria-labelledby="contact-heading">
  <div class="bento-contact__copy">
    <span class="bento-kicker">04 / Contact</span>
    <h2 class="bento-title" id="contact-heading">Let's talk</h2>
    <p class="bento-contact__text">{profile.contactNote}</p>
  </div>

  <div class="bento-contact__links">
    {contactLinks.map((link, index) => (
      <ContactLink link={link} variant={index === 0 ? 'primary' : 'default'} />
    ))}
  </div>
</section>
