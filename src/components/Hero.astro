---
import { profile, contactLinks } from '../data/profile';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';

// 首屏显示前 4 个联系方式（Outlook、WeChat、GitHub、Gmail），全部带图标。
const heroLinks = contactLinks.slice(0, 4);
const hasFacts = profile.facts.length > 0;
---

<section class="bento-tile bento-hero-main" id="top" aria-label="Introduction">
  <div class="bento-hero-top">
    <h1 class="bento-name">
      {profile.name}
      {profile.nameLocal && <span class="bento-name__local">{profile.nameLocal}</span>}
    </h1>

    {
      profile.signature && (
        <p class="bento-quote">
          “{profile.signature}”
          {profile.signatureSource && (
            <cite class="bento-quote__source">— {profile.signatureSource}</cite>
          )}
        </p>
      )
    }

    <p class="bento-lead">{profile.subheadline}</p>

    {
      profile.status && (
        <p class="hero__status">
          <span class="status-dot" aria-hidden="true" />
          {profile.status}
        </p>
      )
    }
  </div>

  {
    heroLinks.length > 0 && (
      <div class="bento-actions">
        {heroLinks.map((link, index) => (
          <ContactLink link={link} variant={index === 0 ? 'primary' : 'default'} />
        ))}
      </div>
    )
  }
</section>

<aside class="bento-tile bento-hero-id" aria-label="Profile snapshot">
  <div class="bento-id-head">
    {
      profile.avatar && (
        <img
          class="bento-avatar-lg"
          src={profile.avatar}
          alt=""
          width="76"
          height="76"
        />
      )
    }
    <span class="bento-pill">RUC · AI '26</span>
  </div>

  {
    hasFacts && (
      <dl class="bento-facts">
        {profile.facts.map((fact) => (
          <div class="bento-fact">
            <dt class="bento-fact__label">
              <Icon name={fact.icon} />
              <span>{fact.label}</span>
            </dt>
            <dd class="bento-fact__value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</aside>
