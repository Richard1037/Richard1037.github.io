---
import { about, skills, interests, uses, type Skill } from '../data/profile';
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';

// 技能项允许两种写法：只写名字的字符串，或带 note 的对象
function normalize(item: string | Skill): Skill {
  return typeof item === 'string' ? { name: item } : item;
}
---

<section class="bento-tile bento-about" id="about" aria-labelledby="about-heading">
  <span class="bento-kicker">01 / About</span>
  <h2 class="bento-title" id="about-heading">A bit about me</h2>

  <div class="bento-body">
    {about.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  {
    uses.length > 0 && (
      <div class="about__block">
        <h3 class="skills__label">Uses</h3>
        <dl class="uses">
          {uses.map((item) => (
            <>
              <dt class="uses__label">{item.label}</dt>
              <dd class="uses__value">
                <Icon name={item.icon} />
                {item.value}
              </dd>
            </>
          ))}
        </dl>
      </div>
    )
  }
</section>

<aside class="bento-tile bento-mascot-tile" aria-label="Mascot and interests">
  <button
    type="button"
    class="bento-mascot-btn"
    data-mascot-greet
    aria-label="Say hi to Nailong"
    title="Click to say hi!"
  >
    <Mascot />
  </button>

  {
    interests.length > 0 && (
      <div class="bento-interests">
        <span class="bento-mono-label">Beyond code</span>
        <ul class="interests__list">
          {interests.map((item) => (
            <li class="tag tag--mint">
              <Icon name={item.icon} />
              <span>{item.name}</span>
              {item.note && <span class="tag__note">{item.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</aside>

{
  skills.length > 0 && (
    <section class="bento-tile bento-skills" aria-labelledby="skills-heading">
      <span class="bento-kicker" id="skills-heading">Skills</span>
      <div class="skills">
        {skills.map((group) => (
          <div class="skills__group">
            {group.collapsible ? (
              <details class="skills__disclosure" open>
                <summary class="skills__label">
                  {group.label}
                  <span class="skills__count">{group.items.length}</span>
                </summary>
                <ul class="skills__list">
                  {group.items.map((item) => {
                    const skill = normalize(item);
                    return (
                      <li class="tag">
                        {skill.name}
                        {skill.note && <span class="tag__note">{skill.note}</span>}
                      </li>
                    );
                  })}
                </ul>
              </details>
            ) : (
              <>
                <h3 class="skills__label">{group.label}</h3>
                <ul class="skills__list">
                  {group.items.map((item) => {
                    const skill = normalize(item);
                    return (
                      <li class="tag tag--mint">
                        {skill.name}
                        {skill.note && <span class="tag__note">{skill.note}</span>}
                      </li>
                    );
                  })}
                </ul>
              </>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
