---
import { experiences, type ExperienceKind } from '../data/profile';
import Icon from './Icon.astro';

// Human-readable label for each experience type.
const kindLabels: Record<ExperienceKind, string> = {
  work: 'Internship',
  research: 'Research',
  competition: 'Competition',
  award: 'Award',
  education: 'Education',
};

/**
 * 每种经历配一个图标（对应 src/data/icons.ts 里的键）。
 * 没有配到图标的类型会自动退回成一个小圆点，所以这里可以按需慢慢补。
 * 想给实习/科研/奖项也配图标，在 icons.ts 里加三个图标再写进这个表即可。
 */
const kindIcons: Partial<Record<ExperienceKind, string>> = {
  education: 'cap',
  competition: 'trophy',
};

// Rendered in the order given in src/data/profile.ts — sort it there.
---

<section class="bento-tile bento-exp" id="experience" aria-labelledby="experience-heading">
  <span class="bento-kicker">03 / Experience</span>
  <h2 class="bento-title" id="experience-heading">Where I've been</h2>

  <div class="bento-exp-grid">
    {
      experiences.map((item) => (
        <article class="exp-card" data-kind={item.kind}>
          <div class="exp-card__meta">
            <span class="exp-card__badge">
              {kindIcons[item.kind] && <Icon name={kindIcons[item.kind]} />}
              <span>{kindLabels[item.kind]}</span>
            </span>
            <span class="exp-card__period">{item.period}</span>
          </div>

          <h3 class="exp-card__title">{item.title}</h3>
          <p class="exp-card__org">{item.org}</p>
          <p class="exp-card__description">{item.description}</p>

          {item.tags && item.tags.length > 0 && (
            <ul class="exp-card__tags">
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )}

          {item.links && item.links.length > 0 && (
            <div class="exp-card__links">
              {item.links.map((link) => (
                <a class="link-arrow" href={link.url} target="_blank" rel="noopener">
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>
