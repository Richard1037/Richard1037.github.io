---
import '../styles/bento.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, seoHeadline, siteDescription } from '../data/profile';

interface Props {
  /** Browser tab / search-result title. Defaults to name + seoHeadline. */
  title?: string;
}

const { title = `${profile.name} · ${seoHeadline}` } = Astro.props;

// Canonical URL for SEO. `Astro.site` comes from `site` in astro.config.mjs —
// remember to change it there once you own a domain.
const site = Astro.site ?? new URL('https://your-domain.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const description = siteDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Link previews on Twitter/X, LinkedIn, WeChat, Slack, etc.
         The image is what turns a bare blue link in a chat app into a card,
         which matters a lot for a page whose job is being passed around. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Tints the browser UI (mobile address bar) to match the theme. The
         inline script below keeps this in step with the toggle. -->
    <meta name="theme-color" content="#f3f4f2" id="theme-color" />

    <!--
      Applies the stored theme before the first paint, so there is never a flash
      of the wrong colours. With scripts disabled everything else still works,
      and the stylesheet falls back to the OS colour-scheme preference.
    -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* Some privacy modes throw on localStorage access. */
        }

        var prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme =
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';

        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('js');

        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#11161f' : '#f3f4f2');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />
    <main id="main" class="container bento-main">
      <slot />
    </main>
    <Footer />

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (button) {
          button.addEventListener('click', function () {
            var root = document.documentElement;
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (e) {
              /* Ignore - the choice simply will not persist. */
            }

            var meta = document.getElementById('theme-color');
            if (meta) meta.setAttribute('content', next === 'dark' ? '#11161f' : '#f3f4f2');
          });
        }

        var toast = document.getElementById('toast');
        var toastTimer = null;
        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add('toast--show');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toast.classList.remove('toast--show');
          }, 1900);
        }

        document.querySelectorAll('[data-copy]').forEach(function (el) {
          el.addEventListener('click', function () {
            var val = el.getAttribute('data-copy');
            if (!val) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(val).catch(function () {});
            }
            var label = el.getAttribute('data-copy-label') || 'Copied';
            showToast(label + ': ' + val);
          });
        });

        document.querySelectorAll('[data-mascot-greet]').forEach(function (el) {
          el.addEventListener('click', function () {
            showToast('Nailong says hi! 👋');
          });
        });
      })();
    </script>
  </body>
</html>
